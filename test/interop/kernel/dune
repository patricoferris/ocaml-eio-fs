(test
 (name test)
 (package eio-fs)
 (libraries eio eio.mock posix eio-fs.mem eio-fs.chaos unix fmt alcotest)
 (deps
  (source_tree traces))
 (action
  (run %{test} test "^(memfs|conformance)$")))

(rule
 (alias host)
 (deps
  (source_tree traces))
 (action
  (run %{exe:test.exe} test host)))

(rule
 (alias regen-traces)
 (deps
  (alias traces/regen))
 (action (progn)))
