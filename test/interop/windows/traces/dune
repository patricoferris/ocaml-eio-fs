   bash
   ../../../provenance/write.sh
   test/interop/windows
   scripts/probe.sh
   scripts/generate.sh
   scripts/paths.ml
   scripts/win_paths.ml
   --
   %{targets}
   --
   bash
   ../scripts/generate.sh
   .
   ../scripts/paths.exe)))
