(copy_files#
 (files ../lib/mem/extents.{ml,mli}))

(copy_files#
 (files ../lib/chaos/chaos_blocks.{ml,mli}))

(copy_files#
 (files ../lib/chaos/chaos_journal.{ml,mli}))

(executable
 (name fuzz)
 (libraries
  eio
  eio.mock
  eio_fs_mem
  eio-fs.chaos
  eio-fs.sync
  alcobar
  fmt
  cstruct
  optint))

(rule
 (alias runtest)
 (enabled_if
  (<> %{profile} afl))
 (deps fuzz.exe)
 (action
  (run %{exe:fuzz.exe})))

(rule
 (alias fuzz)
 (enabled_if
  (= %{profile} afl))
 (deps fuzz.exe)
 (action
  (progn
   (run %{exe:fuzz.exe} --gen-corpus corpus)
   (run afl-fuzz -V 60 -i corpus -o _fuzz -- %{exe:fuzz.exe} @@))))
